# ─────────────────────────────────────────────────────────────
#  Salit Steel — Rebar Estimator Agent  |  Environment Config
# ─────────────────────────────────────────────────────────────
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── LLM Answer Generation (local, via Ollama) ────────────────
# Generation runs on a LOCAL model through Ollama by default — no API key.
# 1. Start Ollama:   ollama serve
# 2. Pull the model: ollama pull qwen3:14b
# MODEL is a local Ollama tag (see `ollama list`). Alternatives:
#   qwen3:8b (faster/weaker), gemma4:26b (larger/slower),
#   qwen3-coder:30b (code-tuned, strong at tables, slowest).
MODEL=qwen3:14b

# Ollama server endpoint (default shown).
OLLAMA_HOST=http://localhost:11434

# Backend for generation: "ollama" (default) or "groq" (cloud fallback).
LLM_BACKEND=ollama

# ── Optional cloud fallback (only used with --backend groq) ───
# Get a key at https://console.groq.com/keys. Not needed for local Ollama.
# When using the groq backend, set MODEL to a Groq model string instead,
# e.g. llama-3.3-70b-versatile.
GROQ_API_KEY=gsk_...

# ── ChromaDB ──────────────────────────────────────────────────
# Path to the persisted local ChromaDB vector store.
# Defaults to ./salit_chroma_db if not set.
CHROMA_DB_PATH=./salit_chroma_db

# ChromaDB collection name for the main RAG database.
CHROMA_COLLECTION=salit_steel_rebar

# ── Embedding Model ───────────────────────────────────────────
# Sentence-transformers model used for local CPU embeddings.
# Change only if you want to swap the embedding model.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Retrieval Settings ────────────────────────────────────────
# Default number of chunks returned per query.
N_RESULTS=6

# ── Logging ───────────────────────────────────────────────────
# Set to DEBUG for verbose pipeline output, INFO for normal.
LOG_LEVEL=INFO
